{
  "name": "memebot4",
  "module": "./app/main.ts",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.919.0",
    "@types/bun": "^1.2.23",
    "drizzle-kit": "^0.31.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "start": "bun ./app/main.ts",
    "task": "bun ./scripts/task.ts",
    "push": "mango push",
    "deps": "bun ./scripts/deps.ts",
    "seed": "bun ./db/seed.ts",
    "db:migrate": "bun ./db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "site:build": "cd site && npm exec -- ng build",
    "transcribe": "bun ./scripts/transcribe.ts",
    "whisper": "bun ./scripts/whisper.ts",
    "readonly": "bun ./scripts/readonly.ts",
    "dumpschema": "sqlite3 memebot.sqlite .schema > schema.sql",
    "llm": "bun ./scripts/llm.ts",
    "dedup": "bun ./scripts/dedup.ts",
    "clean": "bun ./scripts/clean.ts",
    "open": "bun ./scripts/open.ts",
    "meme": "bun ./scripts/meme.ts"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@lmstudio/sdk": "^1.5.0",
    "@snazzah/davey": "^0.1.7",
    "change-case": "^5.4.4",
    "cronbake": "^0.3.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.44.6",
    "mango": "link:mango"
  }
}
